# Dibuat otomatis oleh ./setup.sh (password & secret diacak). Jangan di-commit.
POSTGRES_DB=daylight
POSTGRES_USER=daylight
POSTGRES_PASSWORD=GANTI
JWT_SECRET=GANTI
JWT_TTL_HOURS=12

# Akun MQTT untuk ESP32
MQTT_USER=esp32
MQTT_PASSWORD=GANTI

# Logika pintu / buzzer (dihitung di Node-RED)
DOOR_THRESHOLD_CM=50
DOOR_HOLD_MS=3000
BUZZER_MS=2000

# Pencatatan riwayat
READING_INTERVAL_S=10
RETENTION_DAYS=90
TZ_NAME=Asia/Jakarta
